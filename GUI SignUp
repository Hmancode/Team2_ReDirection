# signup.py

import tkinter as tk
from tkinter import messagebox
from user_database import UserDatabase
from styles import PURPLE, GOLD, LOGO_FONT, TEXT_FONT, INPUT_FONT

db = UserDatabase()

def launch_signup():
    root = tk.Tk()
    root.title("Sign Up - ReDirection")
    root.geometry("400x500")
    root.configure(bg="white")

    # --- Logo Header ---
    logo_frame = tk.Frame(root, bg="white")
    logo_frame.pack(pady=30)

    tk.Label(logo_frame, text="Re", bg="white", fg="black", font=LOGO_FONT).pack(side="left")

    direction_box = tk.Frame(logo_frame, bg=PURPLE, padx=10, pady=5)
    tk.Label(direction_box, text="Direction", bg=PURPLE, fg=GOLD, font=LOGO_FONT).pack()
    direction_box.pack(side="left", padx=(10, 0))

    # --- Form Frame ---
    form_frame = tk.Frame(root, bg="white")
    form_frame.pack(pady=10)

    entries = {}

    for field in ["Username", "Password", "Confirm Password"]:
        tk.Label(form_frame, text=field, font=TEXT_FONT, bg="white").pack(anchor="w", padx=20, pady=(10, 0))
        show_char = "*" if "Password" in field else ""
        entry = tk.Entry(form_frame, font=INPUT_FONT, show=show_char, width=30)
        entry.pack(padx=20, pady=5)
        entries[field] = entry

    # --- Register Button ---
    def on_register():
        username = entries["Username"].get()
        password = entries["Password"].get()
        confirm = entries["Confirm Password"].get()

        if not username or not password or not confirm:
            messagebox.showerror("Something Went Wrong", "All fields are required.")
            return

        if password != confirm:
            messagebox.showerror("Something went Wrong", "Passwords do not match.")
            return

        if db.register(username, password):
            messagebox.showinfo("Success", "Account created! You can log in now.")
            root.destroy()
        else:
            messagebox.showerror("Error", "Username already exists.")

    tk.Button(root, text="Create Account", font=TEXT_FONT, bg=PURPLE, fg="white", command=on_register).pack(pady=20)

    root.mainloop()
