
from abc import ABC, abstractmethod

class ScreenComponent(ABC):
    @abstractmethod
    def render(self):
        pass

    @abstractmethod
    def handle_input(self, input_data):
        pass

class MainFeedScreen(ScreenComponent):
    def __init__(self):
        # Sample anonymous posts (list of dicts)
        self.posts = [
            {"id": 1, "content": "I didn’t get an interview after 20 applications.", "downvotes": 0},
            {"id": 2, "content": "My presentation was a disaster.", "downvotes": 0},
            {"id": 3, "content": "Got rejected because of a typo.", "downvotes": 0},
        ]

    def render(self):
        print("=== Anonymous Feed ===")
        for post in self.posts:
            print(f"Post ID {post['id']}: {post['content']} (Downvotes: {post['downvotes']})")
            print("Buttons: [Downvote] [Delete] [Edit]")
            print()

    def handle_input(self, input_data):
        """
        input_data should be a dict like:
        {"action": "downvote", "post_id": 2}
        """
        action = input_data.get("action")
        post_id = input_data.get("post_id")

        # Find the post by id
        post = next((p for p in self.posts if p["id"] == post_id), None)
        if not post:
            print(f"No post found with ID {post_id}")
            return

        if action == "downvote":
            post["downvotes"] += 1
            print(f"Downvoted post ID {post_id}. New downvote count: {post['downvotes']}")
        elif action == "delete":
            self.posts = [p for p in self.posts if p["id"] != post_id]
            print(f"Deleted post ID {post_id}.")
        elif action == "edit":
            # For demo, just append "(edited)" to content
            post["content"] += " (edited)"
            print(f"Edited post ID {post_id}.")
        else:
            print(f"Unknown action: {action}")

# Demo usage
if __name__ == "__main__":
    screen = MainFeedScreen()
    screen.render()

    # Simulate downvoting post with ID 2
    screen.handle_input({"action": "downvote", "post_id": 2})
    screen.render()

    # Simulate editing post with ID 1
    screen.handle_input({"action": "edit", "post_id": 1})
    screen.render()

    # Simulate deleting post with ID 3
    screen.handle_input({"action": "delete", "post_id": 3})
    screen.render()


